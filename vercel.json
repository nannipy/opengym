{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/pt", "destination": "/pt/index.html" },
    { "source": "/pt/(.*)", "destination": "/pt/index.html" },
    { "source": "/cliente", "destination": "/cliente/index.html" },
    { "source": "/cliente/(.*)", "destination": "/cliente/index.html" },
    { "source": "/((?!assets|pt|cliente|img|gif|favicon|robots).* profile.*|home|plan|workout|stats|history|library|settings|trainer|coach).*", "destination": "/index.html" }
  ]
}
